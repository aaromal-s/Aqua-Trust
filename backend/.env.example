# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017/aqua-trust
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aqua-trust?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/aqua-trust

# JWT Secret for Session Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production

# Frontend Origin for CORS (e.g., https://aqua-trust.vercel.app or * for all)
CORS_ORIGIN=*
